{
  "name": "seo-agent",
  "displayName": "S.E.O Agent",
  "version": "1.0.0",
  "description": "Free, self-hosted SEO data for your agent: keyword research, competitor research, backlinks, and site audits from your own S.E.O Agent instance (no account, no subscription).",
  "author": {
    "name": "S.E.O Agent",
    "url": "https://github.com/ahmadaimee/seo-agent"
  },
  "homepage": "https://github.com/ahmadaimee/seo-agent",
  "repository": "https://github.com/ahmadaimee/seo-agent",
  "license": "MIT",
  "keywords": [
    "seo",
    "keyword-research",
    "serp",
    "site-audit",
    "backlinks",
    "search-console",
    "rank-tracking",
    "local-seo"
  ],
  "mcpServers": {
    "seo-agent": {
      "type": "http",
      "url": "${SEO_AGENT_MCP_URL:-http://localhost:3010/mcp}",
      "headers": {
        "Authorization": "${SEO_AGENT_MCP_AUTH:-}"
      }
    }
  }
}
