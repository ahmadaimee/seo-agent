# Use the full Node image so workerd has a working CA trust store for outbound HTTPS.
FROM node:22

ENV PNPM_HOME=/pnpm
ENV PATH=$PNPM_HOME:$PATH

# Baseline runtime env. These used to live in compose.yaml; with Railway as the
# only deployment target they belong in the image, where they cannot be
# forgotten in a dashboard. Railway service variables still override them.
#
# CLOUDFLARE_INCLUDE_PROCESS_ENV is load-bearing: without it the process
# environment never reaches the cloudflare:workers bindings, so the app boots
# with no DataForSEO key however the variables were set.
ENV CLOUDFLARE_INCLUDE_PROCESS_ENV=true
ENV AUTH_MODE=local_noauth
ENV SEO_AGENT_TELEMETRY_DISABLED=1
ENV DO_NOT_TRACK=1
ENV VITE_SHOW_DEVTOOLS=false

WORKDIR /app

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 3010

# Readiness probe against the unauthenticated setup/health endpoint. The long
# start period covers migrations plus the boot-time vite build (skipped when
# the previous start's build is still valid; see docker-entrypoint.sh).
HEALTHCHECK --interval=30s --timeout=10s --start-period=300s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3010)+'/api/health').then(function(r){process.exit(r.ok?0:1)}).catch(function(){process.exit(1)})"

# Startup (preflight, migrations, conditional build, serve) lives in
# docker-entrypoint.sh. The repo .npmrc raises the V8 heap ceiling
# (node-options) so the ~7400-module SSR build doesn't OOM under Node's ~2GB
# default.
# Strip CRLF first: a Windows checkout would otherwise break `sh`.
CMD ["sh", "-c", "sed -i 's/\\r$//' docker-entrypoint.sh && sh docker-entrypoint.sh"]
